== 4. export du theoreme et de tout ce dont il depend, puis trois noyaux independants
leanexport : code 0 ; 146267 lignes ; sha256 b8df0a1b14cbcff1bae911759ca248c341a2149152c695213c0c9465fcaf937d
theorem X27.K20_est_fausse : X27.EnonceK20Fausse := _

def X27.EnonceK20Fausse :
  Prop :=
  And (X27.Tissu X27.germe X27.naissances17)
    (And (X27.TissuDeCellules X27.germe X27.naissances17)
      (And (forall (u : X27.Vec), Membership.mem X27.tissu22 u → X27.DansEmpilement u)
        (And (X27.PlaceAdmissible X27.tissu22 X27.place) (Not (X27.BouleDansEmpilement X27.place)))))

axiom propext {a b : Prop} : Iff a b → Eq a b

axiom Classical.choice.{u} {α : Sort u} : Nonempty α → α

axiom Quot.sound.{u} {α : Sort u} {r : α → α → Prop} {a b : α} : r a b → Eq (Quot.mk r a) (Quot.mk r b)

